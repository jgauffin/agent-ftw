{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "studio: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/studio" },
      "problemMatcher": "$tsc",
      "group": "build"
    },
    {
      "label": "studio: watch",
      "type": "shell",
      "command": "npm run watch",
      "options": { "cwd": "${workspaceFolder}/studio" },
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "group": "build"
    }
  ]
}
