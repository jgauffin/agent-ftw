{
  "name": "agent-ftw-studio",
  "displayName": "Agent FTW Studio",
  "description": "Design, run, and diagnose agent-ftw agent trees inside VS Code.",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Jonas Gauffin",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:typescript"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agentFtw.openStudio",
        "title": "Agent FTW: Open Studio",
        "category": "Agent FTW"
      }
    ]
  },
  "scripts": {
    "build": "npm run typecheck && npm run test && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@relax.js/core": "^1.6.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "vitest": "^2.1.0"
  }
}
